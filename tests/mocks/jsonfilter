#!/usr/bin/env python3
"""Mock jsonfilter: -i file | -s text | stdin, -e '@.a.b'"""
import json, sys
a = sys.argv[1:]; src = None; expr = None; i = 0
while i < len(a):
    if a[i] == "-i": src = open(a[i+1]).read(); i += 2
    elif a[i] == "-s": src = a[i+1]; i += 2
    elif a[i] == "-e": expr = a[i+1]; i += 2
    else: i += 1
if src is None: src = sys.stdin.read()
try: d = json.loads(src)
except Exception: sys.exit(1)
def walk(d, parts):
    if not parts:
        yield d; return
    p, rest = parts[0], parts[1:]
    star = p.endswith("[*]")
    key = p[:-3] if star else p
    if key:
        if not (isinstance(d, dict) and key in d): return
        d = d[key]
    if star:
        if isinstance(d, list):
            for x in d: yield from walk(x, rest)
        return
    yield from walk(d, rest)
import re
expr = re.sub(r'\[["\']([^"\']+)["\']\]', r'.\1', expr)
parts = [x for x in expr.lstrip("@").strip(".").split(".") if x]
res = list(walk(d, parts))
if not res: sys.exit(1)
for r in res:
    print(json.dumps(r) if isinstance(r, (dict, list)) else (str(r).lower() if isinstance(r, bool) else r))
