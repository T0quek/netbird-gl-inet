#!/bin/sh /etc/rc.common
# netbird-gl agent (supervision, toggle switch, updates).
# shellcheck disable=SC2034
START=96
STOP=09
USE_PROCD=1

start_service() {
	mkdir -p /var/run/netbird-gl
	chmod 700 /var/run/netbird-gl
	procd_open_instance agent
	procd_set_param command /usr/sbin/netbird-gl agent
	procd_set_param respawn 3600 10 0
	procd_close_instance
}
