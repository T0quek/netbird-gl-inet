config main 'main'
	option management_url 'https://api.netbird.io:443'
	option auth 'gl'
	option auth_rpc 'system get_status'
	option switch_invert '0'
	option exit_node ''
	option accept_routes '1'
	option use_dns '1'
	option dns_extra 'local'
	option protect_resolv '1'
	option kill_switch '0'
	option allow_inbound '0'
	option guest_access '0'
	option auto_check '1'
	option auto_update '1'
	option update_delay_days '7'

config state 'state'
	option vpn '1'
	option exit '0'

config update 'update'
